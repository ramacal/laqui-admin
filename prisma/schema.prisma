// Laqui Admin — greenfield domain model.
// Source of truth for behavior: openspec/changes/bootstrap-agency-whatsapp-platform/
//
// Configuration layers:
//   Global   -> game rules and pricing
//   Province -> standard game availability, lotteries, Quiniela calendar
//   Agency   -> branding, WhatsApp target, game visibility, operating schedule
//   Order    -> persisted bet intent, WhatsApp handoff, receipts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// Global game catalog
// ─────────────────────────────────────────────────────────────

enum GameKind {
  QUINIELA // free amount per line, multiplied by draws x lotteries
  NUMBER_PICK // pick N numbers from a fixed range at a global price (Quini 6, Loto Plus)
  UNIT // physical item sold by unit at a fixed price (Telekino, scratch cards): no numbers
}

// Base product = official lottery game (spec global-game-catalog). Rules are global;
// national price with validity (GamePrice), optionally overridden per province (ProvinceGamePrice).
// How a product is sold: by the Lotería terminal (grouped as one "Venta" in the cash register)
// or as a physical item at the agency (its own cash register line, counted by quantity).
enum SaleMode {
  MACHINE
  PHYSICAL
}

model GameDefinition {
  id       String   @id @default(cuid())
  code     String   @unique // "QUINIELA" | "QUINI_6" | "LOTO_PLUS"
  name     String
  kind     GameKind
  saleMode SaleMode @default(MACHINE)
  active   Boolean  @default(true)
  // Picture shown in the panel and the public betting flow (public bucket: juegos/{code}/...).
  imageKey String?  @db.VarChar(500)

  // NUMBER_PICK rules (null for Quiniela)
  pickCount Int?
  minNumber Int?
  maxNumber Int?
  extraMin  Int? // Loto Plus "número plus" 0..9
  extraMax  Int?

  // QUINIELA rules (null for NUMBER_PICK). The minimum per line is a province price.
  maxDigits Int? // up to 4 digits per bet number

  modalities GameModality[]
  prices     GamePrice[]
  provinces  ProvinceGameAvailability[]
  agencies   AgencyGameAvailability[]
  orders     Order[]
  cashItems  CashSessionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// National price history of a base product. In effect: the latest validFrom <= today.
// Amount = ticket price (number pick) or minimum per bet line (Quiniela).
model GamePrice {
  id        String         @id @default(cuid())
  gameId    String
  game      GameDefinition @relation(fields: [gameId], references: [id], onDelete: Cascade)
  amount    Decimal        @db.Decimal(12, 2)
  validFrom DateTime       @db.Date
  note      String?

  createdAt DateTime @default(now())

  @@unique([gameId, validFrom])
}

// Sub-draws a ticket participates in (Loto Plus: Tradicional, Match, Desquite, Sale o Sale).
model GameModality {
  id                 String         @id @default(cuid())
  gameId             String
  game               GameDefinition @relation(fields: [gameId], references: [id], onDelete: Cascade)
  code               String
  name               String
  includedInComplete Boolean        @default(true)
  sortOrder          Int            @default(0)

  @@unique([gameId, code])
}

// ─────────────────────────────────────────────────────────────
// Province: availability, lotteries, Quiniela calendar
// ─────────────────────────────────────────────────────────────

// Country of provinces, lotteries and content ideas (ISO 3166-1 alpha-2 code).
model Country {
  id        String        @id @default(cuid())
  code      String        @unique @db.VarChar(2) // "AR", "UY"
  name      String
  provinces Province[]
  lotteries Lottery[]
  ideas     ContentIdea[]
}

// A province, state or jurisdiction of a country (CABA included).
model Province {
  id             String  @id @default(cuid())
  countryId      String
  country        Country @relation(fields: [countryId], references: [id])
  code           String  @unique // e.g. "SF", "BA"
  name           String
  // Bank where the provincial lottery debits/credits agencies (e.g. Banco Provincia for B).
  // New agencies get their single bank account with this bank.
  settlementBank String?

  contentIdeas ContentIdea[]
  ownLottery   Lottery?      @relation("ProvinceLottery")

  games               ProvinceGameAvailability[]
  lotteries           ProvinceLotteryAvailability[]
  programs            ProvinceQuinielaMonthlyProgram[]
  quinielaRules       ProvinceQuinielaDrawRule[]
  quinielaExceptions  ProvinceQuinielaException[]
  quinielaDrawNumbers ProvinceQuinielaDrawNumber[]
  agencies            Agency[]
  residents           AgencyEmployee[] // employees whose home address is in this province

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  scheduledJobs ScheduledJob[]
}

model ProvinceGameAvailability {
  provinceId      String
  province        Province       @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  gameId          String
  game            GameDefinition @relation(fields: [gameId], references: [id], onDelete: Cascade)
  enabled         Boolean        @default(true)
  // false: uses the national price (GamePrice). true: own price history (ProvinceGamePrice).
  customPrice     Boolean        @default(false)
  // Draw games: maximum per bet (Quiniela: per lottery, "$5.000 por C/Lotería") and how many
  // minutes before the draw the terminals stop taking bets (the draws' closeTime).
  maxBetAmount    Decimal?       @db.Decimal(12, 2)
  cutoffMinutes   Int?
  // Quiniela: prizes can be claimed until the draw date + these days, moved to the next
  // business day (Lotería de la Provincia: 10).
  prizeExpiryDays Int?

  prices ProvinceGamePrice[]

  @@id([provinceId, gameId])
}

// Province's own price history (only when ProvinceGameAvailability.customPrice). In effect:
// the latest validFrom <= today. Amount = ticket price or Quiniela minimum per bet line.
model ProvinceGamePrice {
  id           String                   @id @default(cuid())
  provinceId   String
  gameId       String
  availability ProvinceGameAvailability @relation(fields: [provinceId, gameId], references: [provinceId, gameId], onDelete: Cascade)
  amount       Decimal                  @db.Decimal(12, 2)
  validFrom    DateTime                 @db.Date
  note         String? // "Aumento IPLyC noviembre"

  createdAt DateTime @default(now())

  @@unique([provinceId, gameId, validFrom])
}

// A Quiniela lottery the user can pick (Nacional, Provincia, Santa Fe, ...).
// A state lottery: the organism of a province (or CABA) and its Quiniela "lottery" (Ciudad, Provincia, …).
// Its logo and colors brand the agencies' social pictures (spec social-content "Lottery Brand").
model Lottery {
  id                  String    @id @default(cuid())
  code                String    @unique
  name                String // short name as Quiniela shows it: "Provincia", "Ciudad", "Santa Fe"
  fullName            String? // organism: "Instituto Provincial de Lotería y Casinos"
  countryId           String
  country             Country   @relation(fields: [countryId], references: [id])
  provinceId          String?   @unique // jurisdiction; null = a national lottery (Uruguay)
  province            Province? @relation("ProvinceLottery", fields: [provinceId], references: [id], onDelete: SetNull)
  website             String?   @db.VarChar(300)
  logoKey             String?   @db.VarChar(500) // public storage key, PNG
  brandPrimaryColor   String?   @db.VarChar(9)
  brandSecondaryColor String?   @db.VarChar(9)
  // Its Quiniela draws are offered in Laqui (program, results, orders). Other lotteries are listed for their brand.
  quinielaDraws       Boolean   @default(false)
  active              Boolean   @default(true)

  provinces      ProvinceLotteryAvailability[]
  orderSlices    OrderQuinielaLottery[]
  drawRules      ProvinceQuinielaDrawRule[]
  exceptions     ProvinceQuinielaException[]
  drawNumbers    ProvinceQuinielaDrawNumber[]
  resultReadings QuinielaResultReading[]
  results        QuinielaResult[]
}

model ProvinceLotteryAvailability {
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  lotteryId  String
  lottery    Lottery  @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)

  @@id([provinceId, lotteryId])
}

enum QuinielaDrawSlot {
  PREVIA
  PRIMERA
  MATUTINA
  VESPERTINA
  NOCTURNA
}

enum ProgramStatus {
  DRAFT // parsed import awaiting admin review
  PUBLISHED // applied to the usual week, exceptions and draw numbers; the month is confirmed
  ARCHIVED // superseded by a newer version
}

// One monthly import of the official program for a province. It is a check, not a copy: on
// publish it is compared with the usual week (ProvinceQuinielaDrawRule) and only what differs is
// written (rule changes from a date, date exceptions, draw-number anchors).
// Re-imports create a new version; application logic keeps one PUBLISHED version per month.
model ProvinceQuinielaMonthlyProgram {
  id         String        @id @default(cuid())
  provinceId String
  province   Province      @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  year       Int
  month      Int // 1..12
  version    Int           @default(1)
  status     ProgramStatus @default(DRAFT)

  sourceFileKey String? @db.VarChar(500) // the official PDF, in private storage
  sourceUrl     String? @db.VarChar(500) // where it was downloaded from
  sourceHash    String? @db.VarChar(64) // sha256 of the PDF: a new version only when it changes
  rawParse      Json? // raw parser/LLM output, kept for audit
  draft         Json? // normalized draft reviewed by the admin before publishing
  warnings      Json? // checks that failed (vs. the web schedule, sequences, weekdays…)

  publishedAt DateTime?
  exceptions  ProvinceQuinielaException[]
  drawNumbers ProvinceQuinielaDrawNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, year, month, version])
  @@index([provinceId, year, month, status])
}

// The usual Quiniela week of a province: a lottery takes part in a draw on a weekday at a time,
// from validFrom until validTo (inclusive; null = still in force). A lottery joining or leaving
// a draw, or a new time, closes rows and opens new ones from a date, so the past is kept.
// e.g. Matutina · Montevideo · Monday..Friday (5 rows) · 15:00 · from 2026-01-01.
model ProvinceQuinielaDrawRule {
  id         String           @id @default(cuid())
  provinceId String
  province   Province         @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  slot       QuinielaDrawSlot
  lotteryId  String
  lottery    Lottery          @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  weekday    Int // 0 = Sunday .. 6 = Saturday
  drawTime   DateTime         @db.Time(0) // local time of the draw
  validFrom  DateTime         @db.Date
  validTo    DateTime?        @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provinceId, slot, lotteryId, weekday])
}

enum QuinielaExceptionAction {
  SKIP // not held: the whole day (no slot), one draw (slot) or one lottery in a draw (slot + lottery)
  ADD // a lottery takes part in a draw it usually is not in (slot + lottery + drawTime)
  TIME // the draw (slot) is at another time (drawTime)
  PRIZE_EXPIRY // the day's prizes expire on another date (prizeExpiry)
}

enum QuinielaExceptionSource {
  PROGRAM // written when publishing an official program; replaced when the month is re-published
  MANUAL // entered by an admin; kept
}

// A date that differs from the usual week.
model ProvinceQuinielaException {
  id          String                          @id @default(cuid())
  provinceId  String
  province    Province                        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  date        DateTime                        @db.Date
  action      QuinielaExceptionAction
  slot        QuinielaDrawSlot?
  lotteryId   String?
  lottery     Lottery?                        @relation(fields: [lotteryId], references: [id], onDelete: Restrict, onUpdate: Restrict) // Restrict: a DB check uses lotteryId
  drawTime    DateTime?                       @db.Time(0)
  prizeExpiry DateTime?                       @db.Date
  note        String?
  source      QuinielaExceptionSource         @default(MANUAL)
  programId   String?
  program     ProvinceQuinielaMonthlyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([provinceId, date])
}

// Known official draw number of a lottery in a draw on a date. Other dates are counted from the
// nearest one: +1 every date that draw is held. Publishing a program stores the month's first.
model ProvinceQuinielaDrawNumber {
  provinceId String
  province   Province                        @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  slot       QuinielaDrawSlot
  lotteryId  String
  lottery    Lottery                         @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  date       DateTime                        @db.Date
  number     Int
  source     QuinielaExceptionSource         @default(MANUAL)
  programId  String?
  program    ProvinceQuinielaMonthlyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@id([provinceId, slot, lotteryId, date])
}

// ─── Scheduled jobs (admin "Tareas programadas") ─────────────────
// Background tasks run by the worker (scripts/worker.ts) on a cron schedule, or by hand.

enum JobType {
  QUINIELA_PROGRAM // official monthly program of a province (reads its source website)
  QUINIELA_RESULTS // draw results (extractos) from a source website
  HOLIDAYS // national holidays
}

model ScheduledJob {
  id          String    @id @default(cuid())
  key         String    @unique // handler key in src/lib/jobs (e.g. "quiniela-program-B")
  type        JobType
  // Province-level types: which province and which reader/website ("loteria-gba").
  provinceId  String?
  province    Province? @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  source      String?
  name        String
  description String?   @db.Text
  schedule    String // cron expression, Buenos Aires time (e.g. "0 8 * * *")
  enabled     Boolean   @default(true)

  lastRunAt  DateTime?
  lastStatus JobRunStatus?
  nextRunAt  DateTime?

  runs JobRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobRunStatus {
  RUNNING
  OK
  WARNING // finished, but something needs a look (e.g. a draft to review)
  ERROR
}

enum JobTrigger {
  SCHEDULE
  MANUAL
}

model JobRun {
  id            String       @id @default(cuid())
  jobId         String
  job           ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  trigger       JobTrigger
  status        JobRunStatus @default(RUNNING)
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  summary       String?      @db.Text // one line for the list ("Noviembre 2026: 25 días, 175 sorteos")
  details       Json?
  error         String?      @db.Text
  triggeredById String?
  triggeredBy   User?        @relation("JobRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  readings QuinielaResultReading[]

  @@index([jobId, startedAt])
}

// ─────────────────────────────────────────────────────────────
// Agency
// ─────────────────────────────────────────────────────────────

model Agency {
  id              String   @id @default(cuid())
  slug            String   @unique // public URL segment
  name            String
  provinceId      String
  province        Province @relation(fields: [provinceId], references: [id])
  // Official file number ("número de legajo") assigned by the provincial lottery.
  licenseNumber   String   @db.VarChar(20)
  // The license holder ("titular") is the agency's OWNER in AgencyEmployee.
  // WhatsApp destination, E.164 without "+", e.g. 5491178490421.
  // Null while onboarding: the agency cannot receive orders until it is set.
  cellphoneNumber String?
  email           String?
  active          Boolean  @default(true)
  timezone        String   @default("America/Argentina/Buenos_Aires")

  // Storefront address (province = provinceId)
  street       String?
  streetNumber String? @db.VarChar(10)
  city         String?

  // Branding (logo files live in AgencyAsset)
  primaryColor String?

  assets             AgencyAsset[]
  socialAccounts     AgencySocialAccount[]
  driveConnection    AgencyDriveConnection?
  ownerProducts      OwnerProductAgency[]
  funds              AgencyFund[]
  cashSessions       CashSession[]
  settlements        LotterySettlement[]
  // Cash sessions per day: 1 (single shift) or 2 (morning + afternoon). Suggests the shift.
  cashSessionsPerDay Int                      @default(2)
  employees          AgencyEmployee[]
  games              AgencyGameAvailability[]
  // Schedule: always linked to the owner's general schedule (its exceptions apply).
  // customHours = true: the agency's weekly hours are its own AgencyScheduleRule rows
  // (personalized); false: it inherits the general weekly hours.
  scheduleTemplateId String?
  customHours        Boolean                  @default(false)
  scheduleTemplate   ScheduleTemplate?        @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  scheduleRules      AgencyScheduleRule[]
  scheduleExceptions ScheduleException[]
  customers          AgencyCustomer[]
  orders             Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provinceId, licenseNumber])
  @@index([provinceId])
}

enum AgencyAssetKind {
  LOGO_SYMBOL // round symbol, PNG with transparency (social, documents)
  LOGO_SYMBOL_VECTOR // symbol as SVG (print, any size)
  LOGO_MAIN // symbol + agency name
  PROFILE_PICTURE // 1080x1080 profile picture for Instagram/WhatsApp
}

// Branding files of an agency, stored in the public bucket under
// agencias/{provincia}/{legajo}/marca/{variante}-{v}.{ext}. One current file per kind.
model AgencyAsset {
  id         String          @id @default(cuid())
  agencyId   String
  agency     Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  kind       AgencyAssetKind
  storageKey String          @db.VarChar(500)
  mimeType   String
  sizeBytes  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, kind])
}

// Role inside one agency.
enum EmployeeRole {
  OWNER // dueño: full control, manages admins and employees
  ADMIN // administrador de agencia: daily operation, cannot manage owners
  EMPLOYEE // empleado: orders and receipts only
}

enum EmployeeShift {
  MORNING // mañana
  AFTERNOON // tarde
  FULL_DAY // jornada completa
  ROTATING // rotativo
}

// People working at an agency. A person working at two agencies has one row per agency.
// Former employees are deactivated (active = false + leftAt), never deleted.
// `userId` is optional: an employee can be data-only, without login.
model AgencyEmployee {
  id       String       @id @default(cuid())
  agencyId String
  agency   Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  role     EmployeeRole @default(EMPLOYEE)
  active   Boolean      @default(true)
  userId   String?
  user     User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Personal data. Only the name is required: records are often loaded
  // before CUIL, phone or address are known.
  firstName String
  lastName  String
  cuil      String?   @db.VarChar(11) // 11 digits, no dashes; check digit validated in app
  phone     String?   @db.VarChar(20) // E.164 without "+"
  email     String? // lowercase; matching Google email links the login
  hiredAt   DateTime? @db.Date // fecha de ingreso
  leftAt    DateTime? @db.Date // fecha de egreso; set when deactivated (>= hiredAt)

  // Work
  jobTitle String? // puesto, e.g. "Cajera" (not the access role)
  shift    EmployeeShift? // turno
  notes    String?        @db.Text

  // Social media (only with signed consent)
  publicName         String? // nombre para redes, e.g. "Marisa"
  socialMediaConsent Boolean   @default(false) // permiso firmado para salir en redes
  consentAt          DateTime? @db.Date
  photoKey           String?   @db.VarChar(500) // public bucket: agencias/{prov}/{legajo}/equipo/{id}/foto-{v}.{ext}

  // Home address ("domicilio")
  street            String?
  streetNumber      String?   @db.VarChar(10) // "1234" or "S/N"
  floorApartment    String?   @db.VarChar(20) // "3° B"
  city              String?
  postalCode        String?   @db.VarChar(10)
  addressProvinceId String?
  addressProvince   Province? @relation(fields: [addressProvinceId], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  uploadedTickets BetTicket[]
  driveShares     AgencyDriveShare[]

  @@unique([agencyId, cuil])
  @@unique([agencyId, userId]) // one membership per user per agency
  @@index([cuil])
}

// ─────────────────────────────────────────────────────────────
// Access: users and profiles
// ─────────────────────────────────────────────────────────────

enum PlatformRole {
  NONE // regular user; access comes only from agency memberships
  PLATFORM_ADMIN // manages the whole platform
}

// Login account, created on first Google sign-in (Better Auth core "user" table).
// Agency access = active AgencyEmployee rows linked to this user.
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String
  emailVerified Boolean      @default(false)
  image         String?      @db.VarChar(500)
  platformRole  PlatformRole @default(NONE)
  active        Boolean      @default(true)

  memberships       AgencyEmployee[]
  scheduleTemplates ScheduleTemplate[]
  ownerProducts     OwnerProduct[]
  fundMovements     FundMovement[]
  cashOpened        CashSession[]           @relation("CashSessionOpenedBy")
  settlementsLoaded LotterySettlement[]     @relation("SettlementCreatedBy")
  cashClosed        CashSession[]           @relation("CashSessionClosedBy")
  creditEntries     CreditEntry[]           @relation("CreditEntryCreatedBy")
  jobRuns           JobRun[]                @relation("JobRunTriggeredBy")
  driveConnections  AgencyDriveConnection[] @relation("DriveConnectedBy")
  sessions          Session[]
  accounts          Account[]

  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  resolvedQuinielaResults QuinielaResult[] @relation("QuinielaResultResolvedBy")
}

// ─── Better Auth tables (managed by the auth library) ─────────

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Linked identity provider account (Google).
model Account {
  id                    String    @id @default(cuid())
  accountId             String // Google "sub"
  providerId            String // "google"
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String? // unused: Google SSO only

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

// OAuth state / one-time tokens.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}

// Agency can only hide/show games the province allows; it never redefines rules.
model AgencyGameAvailability {
  agencyId String
  agency   Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  gameId   String
  game     GameDefinition @relation(fields: [gameId], references: [id], onDelete: Cascade)
  visible  Boolean        @default(true)

  @@id([agencyId, gameId])
}

// ─────────────────────────────────────────────────────────────
// Agency schedule (spec: agency-schedule)
// Resolution: agency exception > template exception > weekly hours
// (the agency's own rules when scheduleTemplateId is null, else the template's).
// Times are wall-clock values in the agency time zone.
// ─────────────────────────────────────────────────────────────

// Own weekly hours of an agency WITHOUT template. Several ranges per weekday (split shifts).
model AgencyScheduleRule {
  id       String   @id @default(cuid())
  agencyId String
  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  weekday  Int // 0 = Sunday .. 6 = Saturday
  opensAt  DateTime @db.Time(0)
  closesAt DateTime @db.Time(0)

  @@index([agencyId, weekday])
}

// The owner's "Horario general": inherited by their agencies (Agency.scheduleTemplateId).
// One per owner. Agencies that edit their hours become personalized (own AgencyScheduleRule).
model ScheduleTemplate {
  id          String @id @default(cuid())
  name        String @default("Horario general")
  ownerUserId String
  owner       User   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  rules      ScheduleTemplateRule[]
  exceptions ScheduleException[]
  agencies   Agency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerUserId]) // one general schedule per owner
}

model ScheduleTemplateRule {
  id         String           @id @default(cuid())
  templateId String
  template   ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weekday    Int // 0 = Sunday .. 6 = Saturday
  opensAt    DateTime         @db.Time(0)
  closesAt   DateTime         @db.Time(0)

  @@index([templateId, weekday])
}

enum ScheduleExceptionKind {
  CLOSED
  SPECIAL_HOURS // uses ScheduleExceptionSlot rows
  NORMAL_HOURS // agency only: ignore the general schedule's exception and use the weekly hours
}

// Closed days or special hours over a date range, for ONE agency or for a template
// (exactly one of agencyId / templateId; enforced by a DB check constraint).
model ScheduleException {
  id         String                @id @default(cuid())
  agencyId   String?
  agency     Agency?               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  templateId String?
  template   ScheduleTemplate?     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  startDate  DateTime              @db.Date
  endDate    DateTime              @db.Date // inclusive; = startDate for a single day
  kind       ScheduleExceptionKind @default(CLOSED)
  reason     String? // "Feriado: Navidad", "Vacaciones", "Inventario"
  holidayId  String? // set when created from a national holiday
  holiday    Holiday?              @relation(fields: [holidayId], references: [id], onDelete: SetNull)

  slots ScheduleExceptionSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, startDate])
  @@index([templateId, startDate])
}

model ScheduleExceptionSlot {
  id          String            @id @default(cuid())
  exceptionId String
  exception   ScheduleException @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  opensAt     DateTime          @db.Time(0)
  closesAt    DateTime          @db.Time(0)

  @@index([exceptionId])
}

enum HolidayKind {
  FIXED // inamovible
  MOVABLE // trasladable
  BRIDGE // puente turístico / día no laborable
}

// National holiday calendar (reference only: never closes an agency by itself).
// Synced from ArgentinaDatos with `npm run holidays:sync`.
model Holiday {
  id     String      @id @default(cuid())
  date   DateTime    @db.Date
  name   String
  kind   HolidayKind
  source String      @default("argentinadatos")

  exceptions ScheduleException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, name])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// Customers, orders, receipts
// ─────────────────────────────────────────────────────────────

// Identified primarily by WhatsApp number (spec: Customer Registration by WhatsApp).
// A person, once for the whole platform. The cellphone identifies them: the same number in
// two agencies is the same person. Agencies may know someone without a cellphone (e.g. a
// fiado customer); customers arriving by WhatsApp always have one.
model Customer {
  id              String  @id @default(cuid())
  firstName       String
  lastName        String?
  // Argentine cellphone as WhatsApp uses it: "549" + area code + number (src/lib/phone.ts)
  cellphoneNumber String? @unique
  dni             String? @unique // 7–8 digits, optional (big prizes require identification)

  agencies AgencyCustomer[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// The person as a customer of one agency: the alias is how they call them there
// ("Juan del kiosco"). Fiados hang from here, so what someone owes is per agency.
model AgencyCustomer {
  id         String   @id @default(cuid())
  agencyId   String
  agency     Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  alias      String
  notes      String?  @db.Text
  active     Boolean  @default(true)

  creditEntries CreditEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, customerId])
  @@index([agencyId, alias])
}

enum OrderStatus {
  CREATED // persisted, WhatsApp intent generated
  RECEIPT_UPLOADED // customer attached a payment receipt
  CONFIRMED // agency validated payment / loaded the bet
  REJECTED
  CANCELLED
}

model Order {
  id         String          @id @default(cuid())
  agencyId   String
  agency     Agency          @relation(fields: [agencyId], references: [id])
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id])
  // Official game of the order; null for an order of owner products only.
  gameId     String?
  game       GameDefinition? @relation(fields: [gameId], references: [id])
  status     OrderStatus     @default(CREATED)

  total Decimal @db.Decimal(12, 2)

  // WhatsApp handoff snapshot (contract: whatsapp-order-intent)
  whatsappTarget  String
  whatsappMessage String @db.Text

  // Unguessable token for the public receipt-upload link
  publicToken String @unique @default(cuid())

  items     OrderItem[]
  draws     OrderQuinielaDraw[]
  lotteries OrderQuinielaLottery[]
  receipts  Receipt[]
  tickets   BetTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, createdAt])
  @@index([customerId])
}

// Quiniela: draws selected for the whole order (multiplies every line). A draw is a date and a
// slot of the order's province (the agency's); its lotteries, time and number are resolved
// from the usual week and exceptions (src/lib/quiniela/calendar.ts).
model OrderQuinielaDraw {
  orderId String
  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date    DateTime         @db.Date
  slot    QuinielaDrawSlot

  @@id([orderId, date, slot])
}

// Quiniela: lotteries selected for the whole order (multiplies every line).
model OrderQuinielaLottery {
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lotteryId String
  lottery   Lottery @relation(fields: [lotteryId], references: [id])

  @@id([orderId, lotteryId])
}

enum OrderItemKind {
  QUINIELA_DIRECT
  QUINIELA_REDOBLONA
  NUMBER_PICK
  OWNER_PRODUCT // owner's own product, ordered by quantity
}

// One order line. Quiniela, number-pick and owner-product fields are exclusive by `kind`.
model OrderItem {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind     OrderItemKind
  position Int           @default(0) // display order

  // Line amount: as entered (Quiniela), price snapshot (number pick), or
  // quantity x unit price snapshot (owner product)
  amount Decimal @db.Decimal(12, 2)

  // Owner product line (kind OWNER_PRODUCT); name and unit price are snapshots
  ownerProductId String?
  ownerProduct   OwnerProduct? @relation(fields: [ownerProductId], references: [id], onDelete: SetNull)
  productName    String?
  quantity       Int?
  unitPrice      Decimal?      @db.Decimal(12, 2)

  // Quiniela: bet number (kept as string to preserve leading zeros) and "ubicación" (1, 5, 10, 20)
  number     String?
  placement  Int?
  // Quiniela redoblona: second number and placement
  number2    String?
  placement2 Int?

  // "Bajar": lines derived from a parent line (e.g. 1234 -> 234 -> 34)
  derivedFromId String?
  derivedFrom   OrderItem?  @relation("DerivedLines", fields: [derivedFromId], references: [id], onDelete: Cascade)
  derivedLines  OrderItem[] @relation("DerivedLines")

  // Number pick (Quini 6 / Loto Plus)
  picks       OrderItemPick[]
  extraNumber Int?
  modality    String? // null = complete mode (default)

  @@index([orderId])
}

// Number pick (Quini 6 / Loto Plus): one row per chosen number.
model OrderItemPick {
  itemId   String
  item     OrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  position Int // 1..pickCount, order chosen by the user
  number   Int

  @@id([itemId, position])
  @@unique([itemId, number])
}

enum ReceiptStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// Payment proof sent by the customer. Private bucket:
// agencias/{provincia}/{legajo}/pedidos/{yyyy}/{mm}/{orderId}/comprobante-{id}.{ext}
model Receipt {
  id         String        @id @default(cuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storageKey String        @db.VarChar(500) // object key in the private bucket
  mimeType   String
  sizeBytes  Int
  status     ReceiptStatus @default(PENDING_REVIEW)
  reviewedAt DateTime?
  reviewNote String?       @db.Text

  createdAt DateTime @default(now())

  @@index([orderId])
}

// TENTATIVE: photo of the printed lottery ticket ("boleta") that the agency sends
// to the customer as proof of play. Private bucket:
// agencias/{provincia}/{legajo}/pedidos/{yyyy}/{mm}/{orderId}/boleta-{id}.{ext}
model BetTicket {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storageKey   String          @db.VarChar(500)
  mimeType     String
  sizeBytes    Int
  // Agency staff member who uploaded it
  uploadedById String?
  uploadedBy   AgencyEmployee? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  sentAt       DateTime? // when it was delivered to the customer

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────
// Owner products (spec: owner-products)
// One list per owner; each product is offered in the agencies the owner picks.
// ─────────────────────────────────────────────────────────────

model OwnerProduct {
  id             String    @id @default(cuid())
  ownerUserId    String
  owner          User      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name           String
  description    String?   @db.Text
  imageKey       String?   @db.VarChar(500) // public bucket: duenos/{ownerUserId}/productos/{id}/imagen-{v}.webp
  active         Boolean   @default(true)
  saleMode       SaleMode  @default(PHYSICAL) // physical items get their own cash register line
  // Optional sale window, e.g. a raffle until its draw date (inclusive)
  availableFrom  DateTime? @db.Date
  availableUntil DateTime? @db.Date
  sortOrder      Int       @default(0)

  prices     OwnerProductPrice[]
  agencies   OwnerProductAgency[]
  orderItems OrderItem[]
  cashItems  CashSessionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

// Unit price history. In effect: the latest validFrom <= today.
model OwnerProductPrice {
  id        String       @id @default(cuid())
  productId String
  product   OwnerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  amount    Decimal      @db.Decimal(12, 2)
  validFrom DateTime     @db.Date
  note      String?

  createdAt DateTime @default(now())

  @@unique([productId, validFrom])
}

// Agencies where an owner product is offered.
model OwnerProductAgency {
  productId String
  product   OwnerProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  agencyId  String
  agency    Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@id([productId, agencyId])
  @@index([agencyId])
}

// ─────────────────────────────────────────────────────────────
// Agency finances (spec: agency-finances)
// Each agency has its own payment methods ("medios de cobro"); exactly one bank account.
// Balances are calculated (opening + in − out), never stored.
// ─────────────────────────────────────────────────────────────

enum FundKind {
  CASH // efectivo / caja
  BANK_ACCOUNT // the agency's bank account (one per agency)
  DIGITAL_WALLET // Mercado Pago, Cuenta DNI, MODO, Ualá…
  CARD_TERMINAL // posnet: Getnet, Payway, Clover…
  OTHER
}

model AgencyFund {
  id       String   @id @default(cuid())
  agencyId String
  agency   Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  kind     FundKind
  name     String // "Efectivo", "Cuenta Banco Provincia", "Mercado Pago"

  // Type-specific details
  provider       String? // bank or wallet/terminal provider: "Banco Provincia", "Mercado Pago", "Getnet"
  holderName     String? // titular
  cbuCvu         String? @db.VarChar(22) // 22 digits
  alias          String? @db.VarChar(40)
  merchantNumber String? @db.VarChar(40) // número de comercio / terminal
  accountNumber  String? @db.VarChar(30) // bank account number as Lotería prints it ("C.A. 12345/0")
  reference      String? // free note for the owner

  showToCustomers Boolean  @default(false) // offer these details to customers for paying
  openingBalance  Decimal  @default(0) @db.Decimal(14, 2)
  openingDate     DateTime @db.Date
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)

  movements FundMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

enum MovementDirection {
  IN
  OUT
}

enum MovementKind {
  LOTTERY_DEBIT // Lotería debita (lo recaudado)
  LOTTERY_CREDIT // Lotería acredita (premios, comisiones, devoluciones)
  SALE // venta del turno cobrada en efectivo (generada al cerrar la caja)
  CASH_IN // ingreso de efectivo al negocio
  WITHDRAWAL // retiro de efectivo
  CUSTOMER_PAYMENT // cobro a un cliente (transferencias, pagos de fiado)
  PRIZE_PAYOUT // pago de premio a un cliente
  EXPENSE // gasto
  TRANSFER // between two payment methods of the agency (see transferId)
  ADJUSTMENT // ajuste
  OTHER
}

enum MovementSource {
  MANUAL
  LOTTERY_TICKET // future: from a Lotería ticket/settlement
  CASH_CLOSING // future: from an employee cash closing
}

model FundMovement {
  id            String            @id @default(cuid())
  fundId        String
  fund          AgencyFund        @relation(fields: [fundId], references: [id], onDelete: Cascade)
  date          DateTime          @db.Date
  direction     MovementDirection
  amount        Decimal           @db.Decimal(14, 2) // always positive; direction gives the sign
  kind          MovementKind
  description   String?
  reference     String? // settlement / receipt number
  source        MovementSource    @default(MANUAL)
  // Both legs of a transfer share the same transferId.
  transferId    String?           @db.VarChar(30)
  // Private bucket: agencias/{prov}/{legajo}/finanzas/movimientos/{yyyy}/{mm}/{id}.{ext} (future uploads)
  attachmentKey String?           @db.VarChar(500)

  // Set for movements recorded in a cash session (customer payments, prizes, expenses, close adjustment)
  cashSessionId String?
  cashSession   CashSession?       @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  settlement    LotterySettlement?
  creditEntry   CreditEntry?

  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt    DateTime? // movements are voided, never deleted
  voidReason  String?

  createdAt DateTime @default(now())

  @@index([fundId, date])
  @@index([transferId])
  @@index([cashSessionId])
}

// ─── Cash sessions ("cajas"), one per agency, date and shift ──────

enum CashShift {
  MORNING // turno mañana
  AFTERNOON // turno tarde
  SINGLE // turno único (not mixed with morning/afternoon on the same day)
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id       String            @id @default(cuid())
  agencyId String
  agency   Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  date     DateTime          @db.Date
  shift    CashShift
  status   CashSessionStatus @default(OPEN)

  openingCash Decimal  @db.Decimal(14, 2) // physical cash at the start (change)
  openedById  String?
  openedBy    User?    @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedAt    DateTime @default(now())

  // "Venta" of the sheet: what the terminal reports as sold in the shift (machine products)
  machineSales Decimal? @db.Decimal(14, 2)

  countedCash Decimal?  @db.Decimal(14, 2) // "Efectivo": physical cash left in the drawer at close
  closedById  String?
  closedBy    User?     @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt    DateTime?
  notes       String?   @db.Text

  movements     FundMovement[]
  items         CashSessionItem[]
  creditEntries CreditEntry[]

  @@unique([agencyId, date, shift])
  @@index([agencyId, date])
}

// Physical products counted in a cash session (raspaditas, own products sold by unit).
// Exactly one of gameId / ownerProductId; name and unit price are copied at the time.
model CashSessionItem {
  id             String          @id @default(cuid())
  sessionId      String
  session        CashSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gameId         String?
  game           GameDefinition? @relation(fields: [gameId], references: [id], onDelete: SetNull)
  ownerProductId String?
  ownerProduct   OwnerProduct?   @relation(fields: [ownerProductId], references: [id], onDelete: SetNull)
  name           String
  quantity       Int
  unitPrice      Decimal         @db.Decimal(12, 2)

  @@unique([sessionId, gameId])
  @@unique([sessionId, ownerProductId])
}

// ─── Fiados: what agency customers owe (spec: agency-finances) ──

enum CreditEntryKind {
  CHARGE // se le fió (sube la deuda)
  PAYMENT // pagó (baja la deuda)
}

// Balance owed = charges − payments (not voided). Never stored, never deleted: voided.
model CreditEntry {
  id            String          @id @default(cuid())
  customerId    String
  customer      AgencyCustomer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kind          CreditEntryKind
  amount        Decimal         @db.Decimal(14, 2) // always positive
  date          DateTime        @db.Date
  description   String?
  // Charges made at the counter: the "Deuda de caja" of that session.
  cashSessionId String?
  cashSession   CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  // Payments: the money that came in (cash or a transfer to an account).
  movementId    String?         @unique
  movement      FundMovement?   @relation(fields: [movementId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?     @relation("CreditEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime  @default(now())

  @@index([customerId, date])
  @@index([cashSessionId])
}

// ─── Daily Lotería settlement ticket (spec: agency-finances) ──────

enum SettlementDirection {
  DEBIT // "será debitado de su C.A."
  CREDIT // to be credited to the account
}

// One ticket per agency and issue day. Creates one movement in the agency's bank account
// dated on the due date (VTO); editing updates it and voiding voids it.
model LotterySettlement {
  id            String              @id @default(cuid())
  agencyId      String
  agency        Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  issueDate     DateTime            @db.Date // day printed on the ticket
  issuedAt      DateTime? // full print date/time, if known
  dueDate       DateTime            @db.Date // VTO: day Lotería debits/credits the account
  amount        Decimal             @db.Decimal(14, 2)
  direction     SettlementDirection
  accountNumber String?             @db.VarChar(30) // as printed, e.g. "C.A. 12345/0"
  // Private bucket: agencias/{prov}/{legajo}/finanzas/liquidaciones/{yyyy}/{mm}/{fecha}-{id}.{ext}
  ticketKey     String?             @db.VarChar(500)
  ticketMime    String?
  notes         String?             @db.Text

  movementId String?       @unique
  movement   FundMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?     @relation("SettlementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, issueDate])
  @@index([agencyId, dueDate])
}

// ─── Quiniela results (spec: quiniela-results) ───────────────────
// What each source website published for a draw, and the consolidated result.

enum QuinielaResultStatus {
  PENDING // a single non-official source
  CONFIRMED // sources agree (two or more, or an official one)
  CONFLICT // sources disagree: an admin chooses
}

// One source's reading of a draw. Raw evidence: the 20 numbers as published, in order
// ("5964,2790,…"). A new reading from the same source replaces it (changedAt keeps when).
model QuinielaResultReading {
  id        String           @id @default(cuid())
  source    String // reader key ("loteria-santafe", "jugandoonline"…)
  date      DateTime         @db.Date
  slot      QuinielaDrawSlot
  lotteryId String
  lottery   Lottery          @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  numbers   String           @db.VarChar(160)
  letters   String?          @db.VarChar(20)
  official  Boolean          @default(false) // the source is the lottery itself or an official extract
  jobRunId  String?
  jobRun    JobRun?          @relation(fields: [jobRunId], references: [id], onDelete: SetNull)
  readAt    DateTime         @default(now())
  changedAt DateTime         @default(now())

  @@unique([source, date, slot, lotteryId])
  @@index([date, slot, lotteryId])
}

// The result of a draw, consolidated from its readings.
model QuinielaResult {
  id           String               @id @default(cuid())
  date         DateTime             @db.Date
  slot         QuinielaDrawSlot
  lotteryId    String
  lottery      Lottery              @relation(fields: [lotteryId], references: [id], onDelete: Cascade)
  status       QuinielaResultStatus @default(PENDING)
  letters      String?              @db.VarChar(20)
  sources      Int                  @default(0) // readings that agree with the numbers below
  confirmedAt  DateTime?
  // Set when an admin resolved a conflict: these numbers stay even if sources keep disagreeing.
  resolvedById String?
  resolvedBy   User?                @relation("QuinielaResultResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  numbers QuinielaResultNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, slot, lotteryId])
  @@index([date, status])
}

// The 20 prizes of a result (empty while in conflict). Numbers are text: "0031" keeps its zeros.
model QuinielaResultNumber {
  resultId String
  result   QuinielaResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  position Int // 1..20
  number   String         @db.VarChar(6)

  @@id([resultId, position])
}

// ─── Social content (spec social-content) ─────────────────────

enum SocialNetwork {
  INSTAGRAM
  FACEBOOK
  TIKTOK
}

// One account per network: the handle and the email registered on it. Never passwords.
model AgencySocialAccount {
  id       String        @id @default(cuid())
  agencyId String
  agency   Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  network  SocialNetwork
  handle   String        @db.VarChar(60) // without "@"
  email    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, network])
}

enum ContentIdeaKind {
  PATRIOTIC_DATE // fecha patria
  BIRTH // natalicio / cumpleaños
  DEATH // paso a la inmortalidad / aniversario de muerte
  COMMEMORATION // "Día de…"
  EVENT
}

enum ContentTopic {
  PATRIA
  PROCERES
  FUTBOL
  DEPORTES
  FARANDULA
  MUSICA
  STREAMING
  CULTURA
}

enum ContentIdeaSource {
  SEED
  MANUAL
  WIKIDATA
}

// An idea that repeats every year on day/month. Numbers are derived per year (src/lib/content/numbers.ts).
model ContentIdea {
  id         String            @id @default(cuid())
  kind       ContentIdeaKind
  topic      ContentTopic
  title      String // "Vuelta de Obligado", "José de San Martín"
  month      Int // 1..12
  day        Int // 1..31
  year       Int? // origin year: years elapsed = viewed year - year
  countryId  String
  country    Country           @relation(fields: [countryId], references: [id])
  provinceId String? // null = the whole country
  province   Province?         @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  // Short context for captions and the AI prompt ("Combate en el Paraná contra la flota anglo-francesa").
  summary    String?           @db.Text
  // Templates with {years} {year} {agency}; empty = a default per kind.
  headline   String?           @db.VarChar(200)
  caption    String?           @db.Text
  popularity Int               @default(0) // higher first
  active     Boolean           @default(true)
  source     ContentIdeaSource @default(MANUAL)
  sourceKey  String?           @db.VarChar(100) // stable key for seeds/imports

  numbers ContentIdeaNumber[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceKey])
  @@index([month, day])
}

// Fixed numbers of an idea besides the derived ones (a jersey number, a famous score).
model ContentIdeaNumber {
  id     String      @id @default(cuid())
  ideaId String
  idea   ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  value  Int
  reason String      @db.VarChar(80) // "camiseta"

  @@index([ideaId])
}

// Traditional meaning of the Quiniela numbers ("los sueños"). usable = false: never on posts.
model QuinielaNumberMeaning {
  number  Int     @id // 0..99
  meaning String
  usable  Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Agency Google Drive (spec agency-google-drive)
// ─────────────────────────────────────────────────────────────

enum DriveConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT // Google rejected the refresh token (expired, revoked, scope removed)
  DISCONNECTED // token deleted by the agency; folder ids kept for a reconnection
}

// The agency's own Google account (often its social media account, not the sign-in), scope
// drive.file: Laqui only sees what it creates. Folder Laqui/{Agencia} is shared with the staff.
model AgencyDriveConnection {
  id              String                @id @default(cuid())
  agencyId        String                @unique
  agency          Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  googleEmail     String
  googleAccountId String                @db.VarChar(100) // Drive about.user.permissionId (stable)
  refreshTokenEnc String?               @db.Text // AES-256-GCM "v1.iv.tag.ct", AAD = agencyId; null when disconnected
  rootFolderId    String                @db.VarChar(100) // "Laqui", shared by agencies on the same account
  folderId        String                @db.VarChar(100) // "Laqui/{Agencia}"
  status          DriveConnectionStatus @default(ACTIVE)
  lastError       String?               @db.VarChar(500)
  connectedById   String?
  connectedBy     User?                 @relation("DriveConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt     DateTime
  lastSyncedAt    DateTime?

  shares AgencyDriveShare[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([googleAccountId])
}

enum DriveShareState {
  SHARED // permission created by Laqui: removed when the employee leaves
  MANUAL // the email already had access when Laqui tried: never removed
  FAILED // Google refused the share (e.g. not a Google account); retried on the next sync
}

// One row per email Laqui handled on the agency folder.
model AgencyDriveShare {
  id           String                @id @default(cuid())
  connectionId String
  connection   AgencyDriveConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     AgencyEmployee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  email        String
  state        DriveShareState
  permissionId String?               @db.VarChar(100) // only for SHARED
  role         String                @db.VarChar(20)
  error        String?               @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, email])
  @@index([employeeId])
}
