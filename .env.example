# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Local: MySQL from docker-compose.yml (npm run db:up)
DATABASE_URL="mysql://laqui:laqui_dev@localhost:3306/laqui"
SHADOW_DATABASE_URL="mysql://root:laqui_root@localhost:3306/laqui_shadow"

# Auth (Better Auth + Google SSO)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File storage (S3-compatible). Local: SeaweedFS from docker-compose (npm run db:up).
# Production: AWS S3, Cloudflare R2 or Supabase Storage (S3 API).
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=laqui
STORAGE_SECRET_KEY=laqui_dev_secret
STORAGE_PUBLIC_BUCKET=laqui-public
STORAGE_PRIVATE_BUCKET=laqui-private
# Base URL for public files (a CDN in production)
STORAGE_PUBLIC_URL=http://localhost:8333/laqui-public
