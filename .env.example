# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Local: MySQL from docker-compose.yml (npm run db:up)
DATABASE_URL="mysql://laqui:laqui_dev@localhost:3306/laqui"
SHADOW_DATABASE_URL="mysql://root:laqui_root@localhost:3306/laqui_shadow"

# Auth (Better Auth + Google SSO)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Agency Google Drive (same OAuth client, scope drive.file). Enable the Google Drive API and add
# the authorized redirect URI: http://localhost:3000/api/drive/callback
# Key that encrypts the agencies' Drive refresh tokens (32 bytes, base64url). Changing it
# disconnects every agency. Generate with the same command as BETTER_AUTH_SECRET.
DRIVE_TOKEN_KEY=

# File storage: Cloudflare R2. Local: SeaweedFS from docker-compose simulates it (npm run db:up).
# Production (R2):
#   STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY = an R2 API token (Object Read & Write, both buckets)
#   STORAGE_PUBLIC_URL = the public bucket's custom domain (or its r2.dev URL), e.g. https://archivos.example.com
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=laqui
STORAGE_SECRET_KEY=laqui_dev_secret
STORAGE_PUBLIC_BUCKET=laqui-public
STORAGE_PRIVATE_BUCKET=laqui-private
# Public domain of the public bucket (no bucket name in the path, like R2's)
STORAGE_PUBLIC_URL=http://localhost:8334
